{
  "name": "moeshak-music-windows",
  "version": "5.10.6",
  "description": "موشک موزیک — Telegram music player for Windows (TDLib + Electron)",
  "main": "src/main.js",
  "author": "Moeshak Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "prebuilt-tdlib": "^0.1008067.0",
    "qrcode": "^1.5.4",
    "tdl": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ir.moeshakteam.moeshakmusic",
    "productName": "Moeshak Music",
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MoeshakMusic-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "MoeshakMusic-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moeshak Music"
    }
  }
}
