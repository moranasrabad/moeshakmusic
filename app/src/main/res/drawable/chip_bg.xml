<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#3322D3EE" />
            <stroke android:width="1.5dp" android:color="#FF22D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/moeshak_surface" />
            <stroke android:width="1dp" android:color="@color/moeshak_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
