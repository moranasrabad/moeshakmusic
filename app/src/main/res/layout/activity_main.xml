<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- لایهٔ اصلی: دراور + محتوا -->
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_menu"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/tab_tracks"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- وضعیت اتصال/پروکسی — مثل تلگرام -->
                <ImageView
                    android:id="@+id/ivConn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/proxy_screen_title"
                    android:padding="5dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#F59E0B" />

                <ImageButton
                    android:id="@+id/btnSearchIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_search"
                app:iconifiedByDefault="false"
                app:queryHint="@string/search_hint"
                app:searchIcon="@drawable/ic_search" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabGravity="start"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2.5dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="?attr/colorOnSurface"
                app:tabTextAppearance="@style/MoeshakTab"
                app:tabTextColor="?attr/colorOnSurfaceVariant" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp"
                android:text="MOESHAK MUSIC"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

                android:id="@+id/sideProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/proxy_screen_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/sideProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/proxy_screen_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/sideLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/log_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/sideSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/settings_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/sideTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/theme_setting"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- لایهٔ تمام‌صفحهٔ مستقل: همیشه روی همه‌چیز، بدون تداخل -->
    <FrameLayout
        android:id="@+id/fullScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:elevation="50dp"
        android:focusable="true"
        android:visibility="gone" />

    <!-- مینی‌پلیر — بالای همه (فقط وقتی fs بسته است دیده می‌شود چون fs پس‌زمینه دارد) -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_mini"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/miniArt"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniShuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_shuffle"
            app:tint="?attr/colorOnSurfaceVariant" />

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_play">

            <ImageButton
                android:id="@+id/miniToggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/playing_now"
                android:padding="10dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/moeshak_on_accent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
