<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Moeshak" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/moeshak_accent</item>
        <item name="colorOnPrimary">@color/moeshak_on_accent</item>
        <item name="colorSecondary">@color/moeshak_accent2</item>
        <item name="colorOnSecondary">@color/moeshak_on_accent</item>
        <item name="colorSurface">@color/moeshak_surface</item>
        <item name="colorOnSurface">@color/moeshak_on_surface</item>
        <item name="colorSurfaceVariant">@color/moeshak_elevated</item>
        <item name="colorOnSurfaceVariant">@color/moeshak_muted</item>
        <item name="colorError">@color/moeshak_bad</item>
        <item name="android:colorBackground">@color/moeshak_bg</item>
        <item name="colorOutline">@color/moeshak_elevated</item>
        <item name="android:statusBarColor">@color/moeshak_bg</item>
        <item name="android:navigationBarColor">@color/moeshak_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="MoeshakChip">
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">9dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleImg">
        <item name="cornerSize">50%</item>
    </style>

    <style name="MoeshakTab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">true</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
</resources>
